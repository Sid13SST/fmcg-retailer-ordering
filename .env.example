# Copy to .env and fill in values. Never commit .env.

# SQLite database file (relative to prisma/schema.prisma)
DATABASE_URL=

# Secret used to HMAC-sign the session cookie (any long random string, >= 32 chars)
SESSION_SECRET=

# --- AI order capture (optional) ---
# Leave both empty to use the offline parser (the UI says "Offline parser - no AI key configured").
# Google AI Studio key for Gemini. Sent only as the x-goog-api-key header; never logged or stored.
GEMINI_API_KEY=
# Set to 1 ONLY when a trusted egress proxy injects the key header for you (no key in this file).
GEMINI_VIA_PROXY=
# Optional model overrides (defaults: gemini-flash-latest, then gemini-2.5-flash-lite).
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
