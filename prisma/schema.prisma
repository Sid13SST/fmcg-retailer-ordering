// Kirana OrderDesk — data model.
// All money is stored as integer paise (INR). Never store rupees as floats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Who is acting. Extensible: SALESMAN will be added in a later chunk.
enum Role {
  RETAILER
  ORDER_DESK
}

enum SchemeType {
  BUY_X_GET_Y_FREE
  SLAB_PERCENT_OFF
}

enum OrderStatus {
  DRAFT
  PENDING_DESK_REVIEW
  ON_HOLD
  CONFIRMED
  EXPORTED
  REJECTED
}

enum OrderSource {
  CATALOG
  AI_TEXT
}

enum AICaptureStatus {
  PENDING
  PARSED
  CONFIRMED
  DISCARDED
  /// Extraction failed (e.g. AI returned invalid JSON twice); nothing was parsed.
  FAILED
}

/// Which engine read a text order. Shown to the user; never faked.
enum CaptureEngine {
  GEMINI
  OFFLINE
}

/// Where an alias came from. CURATED = distributor-maintained (seed);
/// CONFIRMED / CORRECTED = learned from a retailer confirming or correcting a capture.
enum AliasSource {
  CURATED
  CONFIRMED
  CORRECTED
}

model Salesman {
  id        String     @id @default(cuid())
  name      String
  phone     String     @unique
  beat      String
  retailers Retailer[]
  createdAt DateTime   @default(now())
}

model DeskUser {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  createdAt DateTime @default(now())
}

model Retailer {
  id               String                  @id @default(cuid())
  name             String
  shopName         String
  phone            String                  @unique
  area             String
  creditLimitPaise Int
  creditUsedPaise  Int                     @default(0)
  salesmanId       String?
  salesman         Salesman?               @relation(fields: [salesmanId], references: [id])
  orders           Order[]
  aiCaptures       AICapture[]
  aliases          Alias[]
  priceOverrides   RetailerPriceOverride[]
  createdAt        DateTime                @default(now())
}

model SKU {
  id                      String                  @id @default(cuid())
  code                    String                  @unique
  name                    String
  brand                   String
  category                String
  caseSize                Int
  dealerPricePerCasePaise Int
  gstRatePercent          Int
  stockCases              Int
  imageEmoji              String?
  imageUrl                String?
  active                  Boolean                 @default(true)
  schemes                 Scheme[]
  orderLines              OrderLine[]
  aliases                 Alias[]
  priceOverrides          RetailerPriceOverride[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
}

/// At most one ACTIVE scheme per SKU (assumption A3); enforced in the seed and
/// application layer since SQLite cannot express a partial unique index via Prisma.
model Scheme {
  id             String     @id @default(cuid())
  skuId          String
  sku            SKU        @relation(fields: [skuId], references: [id])
  type           SchemeType
  thresholdCases Int
  freeCases      Int        @default(0)
  percentOff     Float      @default(0)
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())

  @@index([skuId, active])
}

model Order {
  id                   String                @id @default(cuid())
  orderNumber          String                @unique
  retailerId           String
  retailer             Retailer              @relation(fields: [retailerId], references: [id])
  status               OrderStatus           @default(DRAFT)
  source               OrderSource           @default(CATALOG)
  createdByRole        Role
  subtotalPaise        Int
  discountPaise        Int                   @default(0)
  gstPaise             Int
  grandTotalPaise      Int
  holdReason           String?
  creditShortfallPaise Int?
  /// Reason the desk gave when rejecting (shown to the retailer).
  rejectionReason      String?
  /// When the desk approved (CONFIRMED); drives "export today's approved".
  approvedAt           DateTime?
  exportedAt           DateTime?
  notes                String?
  /// Client-generated idempotency key so a double tap on slow networks cannot create two orders.
  clientRequestId      String?               @unique
  lines                OrderLine[]
  statusEvents         OrderStatusEvent[]
  aiCaptures           AICapture[]
  tallyExports         TallyExport[]
  lineCorrections      OrderLineCorrection[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([retailerId, createdAt])
  @@index([status])
}

model OrderLine {
  id                String                @id @default(cuid())
  orderId           String
  order             Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  skuId             String
  sku               SKU                   @relation(fields: [skuId], references: [id])
  /// Snapshots so history stays correct if the catalogue changes later.
  skuCode           String
  skuName           String
  caseSize          Int
  gstRatePercent    Int
  qtyCases          Int
  unitPricePaise    Int
  freeCases         Int                   @default(0)
  discountPercent   Float                 @default(0)
  discountPaise     Int                   @default(0)
  subtotalPaise     Int
  gstPaise          Int
  totalPaise        Int
  schemeLabel       String?
  /// AI_TEXT orders: the retailer's original words for this line, e.g. "5 peti biscuit chhota".
  sourcePhrase      String?
  /// AI_TEXT orders: the product words used as the alias phrase, e.g. "biscuit chhota".
  sourceProductText String?
  corrections       OrderLineCorrection[]

  @@index([orderId])
}

/// Audit trail of desk corrections to an order line (SKU swap and/or quantity change).
model OrderLineCorrection {
  id           String    @id @default(cuid())
  orderId      String
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderLineId  String
  orderLine    OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  actorName    String
  fromSkuCode  String
  toSkuCode    String
  fromQtyCases Int
  toQtyCases   Int
  /// Retailer alias learned from this correction (AI_TEXT lines only), e.g. "biscuit chhota".
  aliasPhrase  String?
  reason       String?
  createdAt    DateTime  @default(now())

  @@index([orderId, createdAt])
}

/// Audit trail of order status changes. fromStatus is null for the creation event.
model OrderStatusEvent {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorRole  Role
  /// Desk user who acted (null for retailer / system events).
  actorName  String?
  note       String?
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
}

model AICapture {
  id               String          @id @default(cuid())
  retailerId       String
  retailer         Retailer        @relation(fields: [retailerId], references: [id])
  rawText          String
  /// JSON string (SQLite has no native JSON column in Prisma).
  parsedJson       String?
  status           AICaptureStatus @default(PENDING)
  engine           CaptureEngine?
  /// Model id that answered (Gemini only), e.g. gemini-flash-latest.
  model            String?
  /// Honest failure reason when status = FAILED.
  errorMessage     String?
  /// JSON: final lines the retailer confirmed, with corrections and removed lines.
  outcomeJson      String?
  confirmedOrderId String?
  confirmedOrder   Order?          @relation(fields: [confirmedOrderId], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([retailerId, createdAt])
}

/// A phrase a retailer uses for a SKU ("peti biscuit" -> SKU-BS-075).
/// retailerId = null means a distributor-wide alias.
model Alias {
  id         String      @id @default(cuid())
  retailerId String?
  retailer   Retailer?   @relation(fields: [retailerId], references: [id])
  phrase     String
  skuId      String
  sku        SKU         @relation(fields: [skuId], references: [id])
  usageCount Int         @default(1)
  source     AliasSource @default(CURATED)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @default(now()) @updatedAt

  @@unique([retailerId, phrase])
  @@index([phrase])
}

model TallyExport {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  exportedAt DateTime @default(now())
  /// Desk user who exported.
  exportedBy String?
  /// Shared by every order exported in one bulk action; null for a single-order export.
  batchId    String?
  /// Tally-style CSV rows for this order (with header).
  csvPayload String

  @@index([orderId])
  @@index([batchId])
}

/// Stub for per-retailer pricing (assumption A6). Not used by any logic yet.
model RetailerPriceOverride {
  id                      String   @id @default(cuid())
  retailerId              String
  retailer                Retailer @relation(fields: [retailerId], references: [id])
  skuId                   String
  sku                     SKU      @relation(fields: [skuId], references: [id])
  dealerPricePerCasePaise Int
  createdAt               DateTime @default(now())

  @@unique([retailerId, skuId])
}
